# ============================================================
# TN-Agentic — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=tn_agentic
POSTGRES_USER=tn_agent
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL est reconstruite automatiquement par docker-compose à partir des
# variables ci-dessus → pas besoin de la dupliquer ici (override dans compose).

# --- OpenWeatherMap ---
OPENWEATHERMAP_API_KEY=your_owm_api_key_here
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/3.0/onecall

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-5-20250929
CLAUDE_MODEL_PREMIUM=claude-opus-4-5
# Coûts indicatifs USD/M tokens, pour log uniquement
CLAUDE_SONNET_INPUT_PRICE=3.0
CLAUDE_SONNET_OUTPUT_PRICE=15.0
CLAUDE_OPUS_INPUT_PRICE=15.0
CLAUDE_OPUS_OUTPUT_PRICE=75.0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# TELEGRAM_CHAT_ID supporte trois formats :
#   - "12345"                : un destinataire en DM
#   - "12345,67890,11111"    : plusieurs destinataires en DM (séparateur virgule)
#   - "-1001234567890"       : un groupe Telegram (chat_id négatif, préfère cette
#                              forme à plusieurs DM — un seul appel API, plus simple)
# IMPORTANT : chaque destinataire en DM doit avoir d'abord envoyé un message au bot
# (n'importe lequel) sinon Telegram refuse le premier envoi du bot.
TELEGRAM_CHAT_ID=29991777

# --- Ports & URLs publiques ---
# Port hôte sur lequel nginx est exposé. Sur un serveur partagé avec d'autres
# stacks Docker, choisir un port libre (ex 18090, 18091, 8095...).
# Vérifier avec : ss -tlnp | grep <port>  ou  docker ps --format "table {{.Ports}}"
HOST_PORT=18090
# URL publique utilisée dans les notifications Telegram et les liens du dashboard.
# - En local : http://localhost:${HOST_PORT}
# - Sur le VPS sans domaine : http://<IP_serveur>:${HOST_PORT}
# - Avec domaine + reverse proxy externe (jwilder/nginx-proxy par exemple) :
#   https://agent.tunisienumerique.com (et adapter nginx-proxy pour pointer vers tn-nginx:80)
PUBLIC_BASE_URL=http://localhost:18090

# --- Publisher ---
# Backend de publication : file (en attendant API WP) | wordpress (quand dispo)
PUBLISHER_BACKEND=file
# Chemin d'écriture FilePublisher (monté dans le container)
ARTICLES_OUTPUT_DIR=/var/www/articles

# --- WordPress (activable via PUBLISHER_BACKEND=wordpress) ---
#
# Méthode d'authentification :
#   - application_password (RECOMMANDÉ) : Basic Auth avec un App Password
#     généré dans WP Admin → Profil → Mots de passe d'application.
#     Format : "xxxx xxxx xxxx xxxx xxxx xxxx" (24 chars + 5 espaces).
#     Pas besoin de plugin tiers (natif WP 5.6+).
#   - jwt : plugin "JWT Authentication for WP REST API". Demande le mot de
#     passe de connexion WP normal.
WP_AUTH_METHOD=application_password

WP_FR_BASE_URL=https://www.tunisienumerique.com
WP_FR_USERNAME=root
# Avec application_password : coller le mot de passe d'application (avec espaces).
# Avec jwt : coller le mot de passe de connexion WP normal.
WP_FR_PASSWORD=

# Site EN : laisser vide si même WP que FR (les articles en deux langues iront
# sur la même instance), sinon préciser l'URL du WP anglais.
WP_EN_BASE_URL=
WP_EN_USERNAME=
WP_EN_PASSWORD=

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_in_production
GENERIC_TIMEZONE=Africa/Tunis

# --- Services internes (URLs entre containers) ---
SCRAPER_WEATHER_URL=http://scraper-weather:8001
SCRAPER_BCT_URL=http://scraper-bct:8002
EDITORIAL_CORE_URL=http://editorial-core:8000

# --- BCT (Sprint 2) ---
BCT_INDEX_URL=https://www.bct.gov.tn/bct/siteprod/index.jsp

# --- Logging ---
LOG_LEVEL=INFO

# --- Backup (optionnel) ---
OVH_S3_ENDPOINT=
OVH_S3_BUCKET=tn-agentic-backups
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=
